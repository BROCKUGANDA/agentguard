# AgentGuard configuration
# Copy to .env and fill in real values. Never commit .env.

# ----- LLM (the agent's brain) -----
# Default for demo: OpenAI gpt-4o-mini (cheapest, fastest)
OPENAI_API_KEY=

# Alternative: Volcengine ARK (China region, doubao-seed-2.1-pro)
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
# ARK_MODEL=doubao-seed-1-6-250615

# ----- AgentGuard sidecar -----
AGENTGUARD_SIDECAR_URL=http://localhost:9559
AGENTGUARD_SIDECAR_PORT=9559
AGENTGUARD_AUDIT_DB=./data/audit.sqlite
AGENTGUARD_POLICY_FILE=./policies/agentguard.yaml

# ----- Failure mode -----
# When sidecar unreachable: true = deny (safe), false = allow (degraded)
AGENTGUARD_FAIL_CLOSED=true

# ----- Alerting (post-hackathon stretch) -----
# AGENTGUARD_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# AGENTGUARD_ALERT_EMAIL=security@example.com

# ----- OpenTelemetry export (post-hackathon stretch) -----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318